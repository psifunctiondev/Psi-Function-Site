/* =============================================================
   css/header.css
   Site header — three-zone layout:
     LEFT   : logo circle (fills header height with inset)
     CENTER : nav pill (rounded rect, fits content width)
     RIGHT  : theme switcher
   Background matches --color-bg (not a surface — bare page bg).
   Depends on: tokens.css
   ============================================================= */

/* --- Outer bar --- */

.site-header {
  background: var(--color-surface-elevated);
  border-bottom: var(--border-width-thin) solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
}

/* --- Inner row: three explicit zones --- */

.site-header__inner {
  display: grid;
  grid-template-columns: var(--header-height) 1fr auto;
  align-items: center;
  gap: var(--space-4);
  height: var(--header-height);
  padding-inline: var(--space-4);
}

/* -------------------------------------------------------
   LEFT: Logo circle
   Diameter = header height minus top+bottom inset.
   The <img> inside shrinks to fit via object-fit: contain.

   Expected markup:
     <a class="site-logo" href="/">
       <img class="site-logo__img" src="/assets/psi-symbol.png" alt="Psi Function">
     </a>
   ------------------------------------------------------- */

.site-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: start;

  /* Circle geometry */
  aspect-ratio: 1 / 1;
  height: calc(var(--header-height) - var(--space-4) * 2);
  border-radius: var(--radius-pill);

  background: var(--color-bg);
  overflow: hidden;
  text-decoration: none;
  flex-shrink: 0;
}

.site-logo__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  /* Inset so the symbol has breathing room inside the circle */
  padding: var(--space-2);
  box-sizing: border-box;
}

/* -------------------------------------------------------
   CENTER: Nav pill
   Rounded rect, only as wide as its content, centered
   within the middle 1fr column.

   Expected markup:
     <nav class="site-nav">
       <a class="site-nav__link" href="/services">Services</a>
       <a class="site-nav__link" href="/about">About</a>
       <a class="site-nav__link" href="/contact">Contact</a>
     </nav>
   ------------------------------------------------------- */

.site-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: center;

  background: var(--color-bg);
  border-radius: var(--radius-pill);
  height: calc(var(--header-height) - var(--space-4) * 2);
  padding-inline: var(--space-6);
  gap: var(--space-5);

  white-space: nowrap;
}

.site-nav__link {
  color: var(--color-text);
  text-decoration: none;
  font-family: var(--font-family-display);
  font-size: var(--text-sm);
  letter-spacing: var(--letter-spacing-wide);
  line-height: 1;
  transition: color var(--duration-fast) var(--ease-standard);
}

.site-nav__link:hover {
  color: var(--color-accent);
}

.site-nav__link[aria-current="page"] {
  color: var(--color-primary);
}

/* -------------------------------------------------------
   RIGHT: Theme switcher
   Styled in theme-switcher.css; just positioned here.
   ------------------------------------------------------- */

.site-header__controls {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  justify-self: end;
}

/* -------------------------------------------------------
   Mobile: two-row collapse
   Row 1: logo | spacer | controls
   Row 2: nav pill stretches full width
   ------------------------------------------------------- */

@media (max-width: 767px) {
  .site-header__inner {
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    height: auto;
    padding-block: var(--space-3);
  }

  .site-nav {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: stretch;
    justify-content: flex-start;
    border-radius: var(--radius-lg);
    height: auto;
    padding-block: var(--space-2);
    overflow-x: auto;
  }
}
