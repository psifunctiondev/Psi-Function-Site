/* =========================
   hero.css
   Home page hero section.
   Depends on: tokens.css
========================= */

.home-hero__grid {
  display: grid;
  gap: var(--space-6);
}

@media (min-width: 768px) {
  .home-hero__grid {
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
  }
}

.home-hero__title {
  font-size: 2rem;
  line-height: 1.2;
  color: var(--color-heading);
  margin-bottom: var(--space-4);
}

.home-hero__lede {
  color: var(--color-text-muted);
  margin-bottom: var(--space-6);
}

.home-hero__actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.home-hero__media {
  padding: var(--space-4);
  border-radius: var(--radius-md);
}
