# staging.app.env.example — Environment variables for the staging environment
#
# Copy to /opt/consulting-site/staging/shared/env/app.env and fill in real values.

# Flask environment profile (maps to config class in app/config.py)
FLASK_ENV_PROFILE=staging

# Secret key for session signing — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-real-secret

# PostgreSQL connection string
# Format: postgresql://<role>:<password>@localhost/<database>
# Run bootstrap_postgres.sh to generate credentials, then paste the staging URL here.
DATABASE_URL=postgresql://psifunction_staging:CHANGE_ME@localhost/psifunction_staging
